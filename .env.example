# Vorlage für den Zielbetrieb: kopieren nach .env und Werte eintragen.
# Die Datei .env niemals ins Repository einchecken.

# Öffentliche Domain (DNS-A-Record zeigt auf den Server)
DOMAIN=buchen.example.de

# Zufällige Werte, z. B. mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=

# Mailversand über einen Anbieter mit Auftragsverarbeitungsvertrag (z. B. Brevo, Postmark, Mailjet)
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=CourtSlot <noreply@buchen.example.de>

# Angaben für Impressum und Datenschutzerklärung
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
