@startuml zustand_buchung
title CourtSlot – Zustandsdiagramm einer Buchung
skinparam shadowing false
skinparam ArrowColor #0e1b33
skinparam defaultFontName Arial
skinparam defaultFontColor #0e1b33
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #1f4e9c
}
skinparam noteBackgroundColor #f6fbd2
skinparam noteBorderColor #c6d82c
hide empty description

[*] --> Bestaetigt : buchen\n[Slot frei, im Raster, Regeln erfüllt,\nPlatz nicht gesperrt]

state "Bestätigt" as Bestaetigt
state "Storniert" as Storniert
state "Stattgefunden" as Stattgefunden

Bestaetigt --> Storniert : stornieren\n[Mitglied: vor Stornofrist;\nVerwaltung: vor Beginn]
Bestaetigt --> Storniert : Sperre bestätigt
Bestaetigt --> Storniert : Mitgliedschaft gesperrt,\nbeendet oder Konto gelöscht
Bestaetigt --> Stattgefunden : Slotbeginn erreicht

Storniert --> [*]
Stattgefunden --> [*] : nach 12 Monaten gelöscht

note right of Stattgefunden
  Wird nicht gespeichert, sondern aus
  status = bestätigt und startAt <= jetzt abgeleitet.
  Zählt nicht mehr als aktive Buchung.
end note
note right of Storniert
  Slot ist sofort wieder frei.
end note
@enduml
