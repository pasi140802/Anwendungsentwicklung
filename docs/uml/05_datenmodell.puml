@startuml datenmodell
title CourtSlot – Datenmodell (PostgreSQL, Alembic-Migration 0001)
skinparam shadowing false
skinparam ArrowColor #0e1b33
skinparam defaultFontName Arial
skinparam defaultFontColor #0e1b33
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #1f4e9c
skinparam classHeaderBackgroundColor #e6eefb
skinparam noteBackgroundColor #f6fbd2
skinparam noteBorderColor #c6d82c
hide circle
hide methods

entity users {
  * id <<PK>>
  --
  email <<unique>>
  name, password_hash
  email_verified_at
  is_active, is_deleted
  session_version
}
entity clubs {
  * id <<PK>>
  --
  name, kind, Adresse
  join_code <<unique>>
  max_active_bookings, max_days_ahead
  cancel_hours
  summer_start, summer_end
  prime_from, prime_to
}
entity memberships {
  * id <<PK>>
  --
  * user_id <<FK>>
  * club_id <<FK>>
  role, status
  <<unique (user_id, club_id)>>
}
entity invitations {
  * id <<PK>>
  --
  * club_id <<FK>>
  * invited_by_id <<FK>>
  email, role
  accepted_at, revoked
}
entity opening_hours {
  * id <<PK>>
  --
  * club_id <<FK>>
  weekday, opens, closes, is_closed
  <<unique (club_id, weekday)>>
}
entity courts {
  * id <<PK>>
  --
  * club_id <<FK>>
  name, sport, surface
  is_indoor, has_floodlight, season
  slot_minutes (30/60/90/120)
  price_cents, prime_price_cents
  is_active
}
entity bookings {
  * id <<PK>>
  --
  * club_id <<FK>>
  * court_id <<FK>>
  * user_id <<FK>>
  start_at, end_at, price_cents
  status, cancelled_at
  cancelled_by_id <<FK>>
}
entity blocks {
  * id <<PK>>
  --
  * club_id <<FK>>
  * court_id <<FK>>
  start_at, end_at, reason
  * created_by_id <<FK>>
}

users ||--o{ memberships
clubs ||--o{ memberships
clubs ||--o{ invitations
clubs ||--|{ opening_hours
clubs ||--o{ courts
courts ||--o{ bookings
users ||--o{ bookings
courts ||--o{ blocks

note bottom of bookings
  EXCLUDE USING gist (court_id WITH =,
    tstzrange(start_at, end_at, '[)') WITH &&)
  WHERE (status = 'confirmed')
end note
@enduml
