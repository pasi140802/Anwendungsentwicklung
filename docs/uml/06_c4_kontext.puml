@startuml c4_kontext
title CourtSlot – Systemkontext (C4 Ebene 1)
skinparam shadowing false
skinparam ArrowColor #0e1b33
skinparam defaultFontName Arial
skinparam defaultFontColor #0e1b33
skinparam rectangle {
  BorderColor #0e1b33
}
skinparam rectangle<<system>> {
  BackgroundColor #1f4e9c
  FontColor #FFFFFF
  BorderColor #1f4e9c
}
hide stereotype
skinparam actorBorderColor #0e1b33
skinparam actorBackgroundColor #FFFFFF

actor "Spieler / Mitglied\n[Person]\nregistriert sich, tritt Vereinen bei,\nbucht und storniert" as M
actor "Verwaltung\n[Person]\npflegt Plätze, Preise, Regeln,\nMitglieder und Sperren" as A

rectangle "CourtSlot\n[Software-System]\n\nmandantenfähige Buchungsplattform\nfür Tennis- und Padelanlagen" <<system>> as CS

rectangle "E-Mail-Dienst\n[externes System]\nBestätigung, Einladung,\nBuchung, Passwort" as MAIL #FFFFFF
rectangle "Zahlungsdienst\n[externes System, Ausblick]\nOnline-Zahlung" as PAY #edf1f6

M --> CS : Browser (Smartphone/PC), HTTPS
A --> CS : Browser, HTTPS
CS --> MAIL : SMTP
CS ..> PAY : API (Option B)
@enduml
